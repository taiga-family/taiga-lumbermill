{
    "name": "lumbermill",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "scripts": {
        "prepare": "husky",
        "start": "nx serve taiga-lumbermill",
        "build": "npx nx build taiga-lumbermill",
        "start:ssr": "nx serve-ssr taiga-lumbermill",
        "build:ssr": "npx nx build taiga-lumbermill --configuration=ssr",
        "lint": "eslint .",
        "test": "nx test taiga-lumbermill",
        "cspell": "cspell --relative --dot --gitignore .",
        "typecheck": "tsc --noEmit --skipLibCheck --incremental false --tsBuildInfoFile null --project tsconfig.json",
        "prettier": "prettier !package-lock.json !taiga-ui/** . --ignore-path .gitignore",
        "format": "npm run prettier -- --write",
        "stylelint": "stylelint './apps/**/*.{less,css}' --config package.json",
        "serve:ssr:taiga-lumbermill": "node dist/apps/taiga-lumbermill/server/server.mjs"
    },
    "commitlint": {
        "extends": [
            "@taiga-ui/commitlint-config"
        ]
    },
    "lint-staged": {
        "*.less": [
            "stylelint --fix"
        ],
        "*.{js,ts,html}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{svg,yml,md,less,json}": [
            "prettier --write"
        ]
    },
    "browserslist": [
        "extends @taiga-ui/browserslist-config"
    ],
    "eslintConfig": {
        "extends": [
            "plugin:@taiga-ui/experience/all"
        ],
        "rules": {
            "sonarjs/no-redundant-type-constituents": "off"
        }
    },
    "eslintIgnore": [
        "taiga-ui"
    ],
    "stylelint": {
        "extends": [
            "@taiga-ui/stylelint-config"
        ],
        "ignoreFiles": [
            "**/demo/**",
            "**/dist/**",
            "**/coverage/**",
            "**/node_modules/**"
        ]
    },
    "dependencies": {
        "@angular/animations": "22.1.8",
        "@angular/cdk": "22.1.8",
        "@angular/common": "22.1.8",
        "@angular/compiler": "22.1.8",
        "@angular/core": "22.1.8",
        "@angular/forms": "22.1.8",
        "@angular/platform-browser": "22.1.8",
        "@angular/platform-browser-dynamic": "22.1.8",
        "@angular/platform-server": "22.1.8",
        "@angular/router": "22.1.8",
        "@ng-web-apis/universal": "4.15.0",
        "@nx/angular": "23.2.1",
        "@taiga-ui/addon-charts": "4.102.0",
        "@taiga-ui/addon-commerce": "4.102.0",
        "@taiga-ui/addon-table": "4.102.0",
        "@taiga-ui/cdk": "4.102.0",
        "@taiga-ui/core": "4.102.0",
        "@taiga-ui/icons": "4.102.0",
        "@taiga-ui/kit": "4.102.0",
        "@taiga-ui/layout": "4.102.0",
        "@taiga-ui/legacy": "4.102.0",
        "@taiga-ui/styles": "4.102.0",
        "@taiga-ui/tsconfig": "0.280.0",
        "express": "4.21.2",
        "rxjs": "7.8.2",
        "tslib": "2.8.1",
        "zone.js": "0.16.3"
    },
    "devDependencies": {
        "@angular-devkit/core": "22.1.9",
        "@angular-devkit/schematics": "22.1.9",
        "@angular/build": "22.1.9",
        "@angular/cli": "22.1.9",
        "@angular/compiler-cli": "22.1.8",
        "@angular/language-service": "22.1.8",
        "@angular/ssr": "22.1.9",
        "@nx/devkit": "23.2.1",
        "@nx/jest": "23.2.1",
        "@nx/js": "23.2.1",
        "@nx/playwright": "23.2.1",
        "@nx/workspace": "23.2.1",
        "@playwright/test": "1.63.0",
        "@schematics/angular": "22.1.9",
        "@swc-node/register": "1.12.1",
        "@swc/core": "1.16.2",
        "@swc/helpers": "0.5.23",
        "@taiga-ui/browserslist-config": "0.564.0",
        "@taiga-ui/commitlint-config": "0.280.0",
        "@taiga-ui/cspell-config": "0.280.0",
        "@taiga-ui/eslint-plugin-experience": "0.249.0",
        "@taiga-ui/prettier-config": "0.280.0",
        "@taiga-ui/stylelint-config": "0.280.0",
        "@types/express": "5.0.2",
        "@types/jest": "30.0.0",
        "@types/node": "24.19.1",
        "gh-pages": "6.3.0",
        "husky": "9.1.7",
        "jest": "30.5.2",
        "jest-environment-jsdom": "30.5.2",
        "jest-preset-angular": "17.0.2",
        "less": "4.9.0",
        "nx": "23.2.1",
        "ts-jest": "29.4.9",
        "ts-node": "10.9.2",
        "typescript": "6.0.3"
    },
    "engines": {
        "node": "^22.22.3 || ^24.15.0"
    },
    "nx": {}
}
