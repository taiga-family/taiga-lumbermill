{
    "name": "lumbermill",
    "version": "0.0.0",
    "private": true,
    "license": "MIT",
    "scripts": {
        "build": "npx nx build taiga-lumbermill",
        "build:ssr": "npx nx build taiga-lumbermill --configuration=ssr",
        "cspell": "cspell --relative --dot --gitignore .",
        "format": "npm run prettier -- --write",
        "lint": "eslint .",
        "prepare": "husky",
        "prettier": "prettier !package-lock.json !taiga-ui/** . --ignore-path .gitignore --ignore-path .prettierignore",
        "serve:ssr:taiga-lumbermill": "node dist/apps/taiga-lumbermill/server/server.mjs",
        "start": "nx serve taiga-lumbermill",
        "start:ssr": "nx serve-ssr taiga-lumbermill",
        "stylelint": "stylelint './apps/**/*.{less,css}' --config package.json",
        "test": "nx test taiga-lumbermill",
        "typecheck": "tsc --noEmit --skipLibCheck --incremental false --tsBuildInfoFile null --project tsconfig.json"
    },
    "commitlint": {
        "extends": [
            "@taiga-ui/commitlint-config"
        ]
    },
    "lint-staged": {
        "*.less": [
            "stylelint --fix"
        ],
        "*.{js,ts,html}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{svg,yml,md,less,json}": [
            "prettier --write"
        ]
    },
    "browserslist": [
        "extends @taiga-ui/browserslist-config"
    ],
    "prettier": "@taiga-ui/prettier-config",
    "stylelint": {
        "extends": [
            "@taiga-ui/stylelint-config"
        ],
        "ignoreFiles": [
            "**/demo/**",
            "**/dist/**",
            "**/coverage/**",
            "**/node_modules/**"
        ]
    },
    "dependencies": {
        "@angular/cdk": "22.1.8",
        "@angular/common": "22.1.8",
        "@angular/compiler": "22.1.8",
        "@angular/core": "22.1.8",
        "@angular/forms": "22.1.8",
        "@angular/platform-browser": "22.1.8",
        "@angular/platform-browser-dynamic": "22.1.8",
        "@angular/platform-server": "22.1.8",
        "@angular/router": "22.1.8",
        "@ng-web-apis/universal": "5.4.0",
        "@nx/angular": "23.2.1",
        "@taiga-ui/addon-charts": "5.27.0",
        "@taiga-ui/addon-commerce": "5.27.0",
        "@taiga-ui/addon-table": "5.27.0",
        "@taiga-ui/cdk": "5.27.0",
        "@taiga-ui/core": "5.27.0",
        "@taiga-ui/icons": "5.27.0",
        "@taiga-ui/kit": "5.27.0",
        "@taiga-ui/layout": "5.27.0",
        "@taiga-ui/styles": "5.27.0",
        "express": "4.21.2",
        "rxjs": "7.8.2",
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "@angular-devkit/core": "22.1.9",
        "@angular-devkit/schematics": "22.1.9",
        "@angular/build": "22.1.9",
        "@angular/cli": "22.1.9",
        "@angular/compiler-cli": "22.1.8",
        "@angular/language-service": "22.1.8",
        "@angular/ssr": "22.1.9",
        "@nx/devkit": "23.2.1",
        "@nx/js": "23.2.1",
        "@nx/playwright": "23.2.1",
        "@nx/workspace": "23.2.1",
        "@playwright/test": "1.63.0",
        "@schematics/angular": "22.1.9",
        "@swc-node/register": "1.12.1",
        "@swc/core": "1.16.2",
        "@swc/helpers": "0.5.23",
        "@taiga-ui/browserslist-config": "0.564.0",
        "@taiga-ui/commitlint-config": "0.564.0",
        "@taiga-ui/cspell-config": "0.564.0",
        "@taiga-ui/eslint-plugin-experience-next": "0.564.0",
        "@taiga-ui/prettier-config": "0.564.0",
        "@taiga-ui/stylelint-config": "0.564.0",
        "@types/express": "5.0.6",
        "@types/node": "24.19.1",
        "eslint": "9.39.5",
        "gh-pages": "6.3.0",
        "husky": "9.1.7",
        "jsdom": "30.1.2",
        "less": "4.9.1",
        "lint-staged": "17.6.0",
        "nx": "23.2.1",
        "typescript": "6.0.3",
        "vitest": "4.1.11"
    },
    "engines": {
        "node": "^22.22.3 || ^24.15.0"
    },
    "nx": {
        "includedScripts": []
    }
}
