{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "moduleResolution": "bundler",
        "outDir": "../../dist/out-tsc",
        "types": ["node"]
    },
    "angularCompilerOptions": {
        "extendedDiagnostics": {
            "checks": {
                "nullishCoalescingNotNullable": "suppress",
                "optionalChainNotNullable": "suppress"
            }
        }
    },
    "files": [
        "src/main.ts",
        "src/main.server.ts",
        "server.ts"
    ],
    "include": ["src/**/*.d.ts"],
    "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts"]
}
