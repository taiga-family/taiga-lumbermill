{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "strict": true,
        "allowJs": true,
        "forceConsistentCasingInFileNames": true,
        "module": "preserve",
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noPropertyAccessFromIndexSignature": true,
        "outDir": "../../dist/out-tsc",
        "sourceMap": false
    },
    "include": [
        "**/*.ts",
        "**/*.js",
        "playwright.config.ts",
        "src/**/*.spec.ts",
        "src/**/*.spec.js",
        "src/**/*.test.ts",
        "src/**/*.test.js",
        "src/**/*.d.ts"
    ]
}
