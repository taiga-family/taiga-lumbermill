{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "strict": true,
        "incremental": true,
        "module": "esnext",
        "types": ["vitest/globals", "node"]
    },
    "include": [
        "apps/**/*.ts",
        "scripts",
        "*.spec.ts",
        "*.cy.ts"
    ],
    "exclude": ["**/node_modules", "*.js"]
}
